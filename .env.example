# Local development environment — do not commit secrets.
APP_ENV=development
API_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm?sslmode=disable
JWT_SECRET=dev-only-change-me-in-production-use-long-secret
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080

# Bootstrap Super Admin (created only when users table is empty)
BOOTSTRAP_ADMIN_EMAIL=admin@crm.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=Super Admin

# Communication provider credentials are stored per account in the database
# (never sent to the frontend). Create accounts via:
#   POST /api/v1/communications/accounts
# Meta WhatsApp credentials JSON keys: access_token, app_secret, verify_token, graph_api_version
# Gmail / Google OAuth (leave empty in local unless connecting a real account)
# Create OAuth client in Google Cloud Console with redirect:
#   {PUBLIC_API_URL}/api/v1/email/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=
TOKEN_ENCRYPTION_KEY=
